# ============================================================
# TIMBER CHARM - CUSTOM WOOD FURNITURE DESIGN SYSTEM
# ============================================================

FURNITURE = {
    "1": ("Sofa", ["Teak", "Oak", "Indian Rosewood", "Pine"]),
    "2": ("Bed", ["Teak", "Walnut", "Indian Rosewood", "Mango"]),
    "3": ("TV Stand", ["Teak", "Vengai", "Indian Rosewood", "Plywood"]),
    "4": ("Wardrobe", ["Teak", "White Oak", "Plywood", "Pine"]),
    "5": ("Dining Table", ["Teak", "Sal", "Indian Rosewood", "Mango"]),
    "6": ("Window", ["Teak", "Sal", "Vengai", "Pine"]),
    "7": ("Door", ["Teak", "Sal", "Indian Rosewood", "Plywood"]),
    "8": ("Swing", ["Teak", "Vengai", "Indian Rosewood", "Mahogany"]),
    "9": ("Dressing Table", ["Teak", "Mango", "Indian Rosewood", "Plywood"]),
    "10": ("Teapoy", ["Teak", "Oak", "Indian Rosewood", "Pine"])
}

DESIGNS = {
    "1": "Classic",
    "2": "Modern",
    "3": "Traditional",
    "4": "Contemporary"
}

WOOD_COLORS = {
    "Teak": "#A66A2C",
